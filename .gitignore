# Copia antiga do projeto, usada so como backup local (~162 MB)
/Atual/

# Imagens enviadas pelos usuarios: ficam fora, com uma excecao.
# As fotos das contas demo (nome demo-*) vao no repositorio para os perfis de
# exemplo aparecerem completos; todo o resto de uploads/ e ignorado.
Projeto/uploads/*
!Projeto/uploads/banner/
!Projeto/uploads/galeria/
!Projeto/uploads/pacotes/
!Projeto/uploads/perfil-promotor/
!Projeto/uploads/perfil-cliente/

Projeto/uploads/banner/*
!Projeto/uploads/banner/demo-*
Projeto/uploads/galeria/*
!Projeto/uploads/galeria/demo-*
Projeto/uploads/pacotes/*
!Projeto/uploads/pacotes/demo-*
Projeto/uploads/perfil-promotor/*
!Projeto/uploads/perfil-promotor/demo-*
Projeto/uploads/perfil-cliente/*
!Projeto/uploads/perfil-cliente/demo-*

# Backups locais
Projeto/backups/

# Artefatos de execucao do setup local (gerados na maquina de quem roda)
Projeto/servidor.porta
Projeto/.mysql-iniciado
Projeto/.setup-tmp
Projeto/.verifica-tmp
Projeto/setup.log

# Logs
*.log

# Ferramentas locais do agente
.agents/
.freebuff/

# Sistema operacional / editores
Thumbs.db
desktop.ini
.DS_Store
*.swp
.idea/
.vscode/
